{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenReview config",
  "$id": "https://raw.githubusercontent.com/sankara-sabapathy/openreview/main/schema/openreview.schema.json",
  "type": "object",
  "required": ["version", "providers", "reviews"],
  "properties": {
    "version": { "const": 1 },
    "requires_action": {
      "type": "string",
      "description": "Optional minimum action release, e.g. '>=0.3.0'. The workflow ref selects the release; this only fails fast."
    },
    "extends": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Template inheritance: openreview/<name>@<version>, github:<owner>/<repo>[/path]@sha:<hex> (immutable pin required), ./local.yml. Resolved in order, this file overlays on top."
    },
    "defaults": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "lang": { "type": "string" },
        "ignore": { "type": "array", "items": { "type": "string" } },
        "max_diff_chars": { "type": "integer", "minimum": 1000 },
        "max_runtime_s": { "type": "integer", "minimum": 30, "maximum": 14400, "description": "Wall-clock budget for the whole run, seconds (default 1200)." },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 32, "description": "Max agents in flight per review (default 4)." },
        "max_context_chars": { "type": "integer", "minimum": 0 },
        "include_full_files": { "type": "boolean" },
        "profile": { "enum": ["quiet", "balanced", "assertive"] },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_findings": { "type": "integer", "minimum": 1 },
        "suppress": { "type": "array", "items": { "type": "string" }, "description": "Decided-item regexes (case-insensitive, tested against file + comment) suppressed before verdict math." }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["model"],
        "properties": {
          "kind": { "enum": ["anthropic", "openai", "opencode", "openai-compatible"] },
          "protocol": { "enum": ["openai-chat", "anthropic-messages"] },
          "model": { "type": "string" },
          "base_url": { "type": "string" },
          "key_from": { "type": "string" },
          "auth": {
            "type": "object",
            "properties": {
              "header": { "type": "string" },
              "scheme": { "type": "string" }
            }
          },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "endpoint_path": { "type": "string" },
          "json_mode": { "type": "boolean" },
          "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
          "timeout_s": { "type": "integer", "minimum": 10, "maximum": 600, "description": "Per-attempt total cap in seconds (default 420); 90s idle + 60s/1KB trickle guards kill dead hangs regardless." },
          "extra_body": { "type": "object" },
          "models": {
            "type": "object",
            "description": "Named per-model overrides sharing this entry's transport + credential. Agents address them as provider.entry.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "kind": { "enum": ["anthropic", "openai", "opencode", "openai-compatible"] },
                "model": { "type": "string" },
                "protocol": { "enum": ["openai-chat", "anthropic-messages"] },
                "base_url": { "type": "string" },
                "key_from": { "type": "string" },
                "auth": { "type": "object" },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "endpoint_path": { "type": "string" },
                "json_mode": { "type": "boolean" },
                "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
                "timeout_s": { "type": "integer", "minimum": 10, "maximum": 600 },
                "extra_body": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "main"],
        "properties": {
          "id": { "type": "string" },
          "if_paths": { "type": "array", "items": { "type": "string" } },
          "strategy": { "enum": ["any", "all", "majority"] },
          "main": { "$ref": "#/definitions/agent" },
          "subagents": { "type": "array", "items": { "$ref": "#/definitions/agent" } },
          "context_files": { "type": "array", "items": { "type": "string" } },
          "include_full_files": { "type": "boolean" },
          "max_context_chars": { "type": "integer", "minimum": 0 },
          "profile": { "enum": ["quiet", "balanced", "assertive"] },
          "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "max_findings": { "type": "integer", "minimum": 1 },
          "suppress": { "type": "array", "items": { "type": "string" } },
          "verdict": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["comment", "approve", "request_changes"] },
              "min_severity": { "enum": ["suggestion", "medium", "high"] },
              "post_inline": { "type": "boolean" },
              "deduplicate": { "type": "boolean" }
            }
          }
        }
      }
    },
    "global_verdict": {
      "type": "object",
      "properties": {
        "strategy": { "enum": ["any_blocking", "max_severity", "majority"] },
        "sticky_comment": { "type": "boolean" },
        "sticky_comment_mode": { "enum": ["update", "append"] },
        "fail_check_on_request_changes": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "agent": {
      "type": "object",
      "required": ["provider", "instructions"],
      "properties": {
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "instructions": { "type": "string", "minLength": 1 }
      }
    }
  }
}
